{
  "name": "dsh-restart-foot",
  "version": "1.0.0",
  "description": "Restart button at the sidebar foot, directly above the Settings entry: stops the whole desktop app process tree and starts it again.",
  "type": "module",
  "license": "MIT",
  "author": "inn <1207291706@users.noreply.github.com>",
  "homepage": "https://github.com/1207291706/dsh-restart-foot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1207291706/dsh-restart-foot.git"
  },
  "bugs": {
    "url": "https://github.com/1207291706/dsh-restart-foot/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "desktop",
    "windows",
    "sidebar"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}